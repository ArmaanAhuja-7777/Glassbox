{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowcanvas",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
  },
  "preview_urls": true,
  "workers_dev": true,
  "send_metrics": false,
}
