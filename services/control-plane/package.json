{
  "name": "@flowcanvas/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts migrate",
    "db:status": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts status",
    "db:allow": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts allow"
  },
  "dependencies": {
    "@flowcanvas/graph-model": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "fastify": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
