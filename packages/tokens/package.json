{
  "name": "@flowcanvas/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./css/tokens.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "generate": "figma-tokens --base source/base.tokens.json --theme dark=source/color.dark.tokens.json --theme light=source/color.light.tokens.json --css css/tokens.css --ts src/tokens.generated.ts",
    "generate:check": "pnpm run generate --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@flowcanvas/figma-tokens": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
